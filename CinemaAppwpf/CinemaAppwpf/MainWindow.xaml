<Window x:Class="CinemaAppwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Sistem Gestiune - Cinema &amp; Teatru" 
        Height="650" Width="1000" MinHeight="500" MinWidth="800" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <TabControl Name="tabControlPrincipal" Margin="10">

            <TabItem Header="1. Administrare Locații">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,15,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Cauta Locație:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Name="txtCautaLocatie" Width="250" TextChanged="txtCautaLocatie_TextChanged"/>
                        </StackPanel>

                        <DataGrid Name="gridLocatii" AutoGenerateColumns="False" IsReadOnly="True" 
                                  SelectionChanged="gridLocatii_SelectionChanged" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nume Locație" Binding="{Binding Nume}" Width="*"/>
                                <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="80"/>
                                <DataGridCheckBoxColumn Header="VIP" Binding="{Binding AreVIP}" Width="50"/>
                                <DataGridTextColumn Header="Înființare" Binding="{Binding DataInfiintarii, StringFormat=dd.MM.yyyy}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <Border Grid.Column="1" Background="White" Padding="15" BorderBrush="LightGray" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Formular Locație" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#0078D7"/>

                            <Label Name="lblNumeLocatie" Content="Nume Locație:"/>
                            <TextBox Name="txtNumeLocatie" Text="{Binding Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Name="errNumeLocatie" Text="Nume invalid (gol sau prea lung)!" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,-10,0,10"/>

                            <Label Content="Tip Locație:"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Name="rbCinema" Content="Cinema" GroupName="TipLoc" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton Name="rbTeatru" Content="Teatru" GroupName="TipLoc"/>
                            </StackPanel>

                            <Label Content="Data Înființării:"/>
                            <DatePicker Name="dpDataInfiintarii" Margin="0,5,0,15" SelectedDate="{x:Static sys:DateTime.Today}"/>

                            <Label Content="Facilități:"/>
                            <CheckBox Name="chkVIP" Content="Are Zonă VIP / Loje" Margin="0,5,0,20"/>

                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="Adaugă Nou" Click="btnAdaugaLoc_Click" Background="#28A745"/>
                                <Button Content="Modifică" Click="btnModificaLoc_Click" Background="#FFC107" Foreground="Black"/>
                                <Button Content="Șterge" Click="btnStergeLoc_Click" Background="#DC3545"/>
                                <Button Content="Curăță Câmpuri" Click="btnCurataLoc_Click" Background="Gray"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="2. Administrare Spectacole">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock DockPanel.Dock="Top" Text="Lista Spectacole înregistrate:" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListBox Name="listaSpectacole" DisplayMemberPath="AfisareLista" SelectionChanged="listaSpectacole_SelectionChanged"/>
                    </DockPanel>

                    <Border Grid.Column="1" Background="White" Padding="15" BorderBrush="LightGray" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Formular Spectacol" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#0078D7"/>

                            <Label Name="lblNumeSpec" Content="Nume Spectacol:"/>
                            <TextBox Name="txtNumeSpec"/>
                            <TextBlock Name="errNumeSpec" Text="Eroare: Trebuie completat!" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,-10,0,10"/>

                            <Label Name="lblPret" Content="Preț Bilet (RON):"/>
                            <TextBox Name="txtPret"/>
                            <TextBlock Name="errPret" Text="Eroare: Trebuie să fie un număr valid!" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,-10,0,10"/>

                            <Label Name="lblLocatieAsociata" Content="Locația de desfășurare:"/>
                            <ComboBox Name="cmbLocatieAsociata" DisplayMemberPath="Nume" Height="30" Margin="0,5,0,20"/>

                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="Adaugă" Click="btnAdaugaSpec_Click" Background="#28A745"/>
                                <Button Content="Modifică" Click="btnModificaSpec_Click" Background="#FFC107" Foreground="Black"/>
                                <Button Content="Șterge" Click="btnStergeSpec_Click" Background="#DC3545"/>
                            </WrapPanel>

                            <Separator Margin="0,15,0,10"/>
                            <Button Content="Deschide Harta pentru Rezervare" Click="btnDeschideRezervare_Click" Background="#17A2B8" Height="40" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="3. Harta Rezervări" Name="tabRezervare">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="txtTitluRezervare" Grid.Row="0" Text="Selectează un spectacol din Tab-ul 2 mai întâi." FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" Background="LightGray">
                        <UniformGrid Name="gridScaune"/>
                    </Border>

                    <TextBlock Name="txtPretRezervare" Grid.Row="2" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="DarkRed" Margin="10"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>